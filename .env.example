MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=knowops
MYSQL_USER=knowops
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_me
REDIS_URL=redis://127.0.0.1:16379/0
MILVUS_URI=http://127.0.0.1:19540
MINIO_USER=knowopsminio
MINIO_PASSWORD=replace_me
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Embedding：默认真实本地模型（Apple Silicon 优先 MPS，失败回退 CPU）
EMBEDDER_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_LENGTH=1024
# 可选本地模型目录；HuggingFace 直连不通时可把 HF_ENDPOINT 指向镜像
EMBEDDING_MODEL_PATH=
HF_ENDPOINT=https://hf-mirror.com

# Milvus 索引
MILVUS_COLLECTION_PREFIX=knowops_chunks
INDEX_BATCH_SIZE=64
INDEX_MAX_RETRIES=3

# 可选重排序：接口显式设置 rerank=true 才启用
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_MODEL_PATH=
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=4

# 文档版本上传时记录切分策略；旧版本不会自动重切
CHUNK_STRATEGY=fixed
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# 演示开放注册：新账号获得独立空间；仅在 AUTH_MODE=enforced 生效
PUBLIC_REGISTRATION_ENABLED=true

# 密码存储：scrypt（默认）或 plaintext（演示用，数据库可直接看到密码）
PASSWORD_STORAGE=scrypt

# 高频问答优先匹配与 Redis 精确请求缓存
FAQ_ENABLED=true
FAQ_SIMILARITY_THRESHOLD=0.85
FAQ_SIMILARITY_MARGIN=0.05
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=300
